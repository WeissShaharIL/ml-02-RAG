# ── RAG Platform Config ────────────────────────────────────────────────────────
# Set GPU_ENABLED=true on a machine with a supported GPU (NVIDIA/AMD/Apple).
# Restart with: docker compose down && docker compose up
GPU_ENABLED=false

# ── GPU settings (only used when GPU_ENABLED=true) ─────────────────────────────
# NVIDIA:        GPU_DRIVER=nvidia  GPU_COUNT=1  GPU_CAPS=[gpu]
# AMD (ROCm):    GPU_DRIVER=amdgpu  GPU_COUNT=1  GPU_CAPS=[gpu,compute]
# Apple Silicon: GPU not configurable via Compose — Ollama detects Metal automatically.
GPU_DRIVER=
GPU_COUNT=
GPU_CAPS=

# ── Model config ───────────────────────────────────────────────────────────────
# Main model used for query rewriting, question generation, and answering
OLLAMA_MODEL=llama3.2:3b

# Judge model used for eval scoring — can be a larger model for better accuracy
# Examples: mistral:7b, llama3.1:8b, gemma2:9b
# If same as OLLAMA_MODEL, no extra download needed
OLLAMA_JUDGE_MODEL=llama3.2:3b